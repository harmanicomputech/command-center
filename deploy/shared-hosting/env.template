APP_NAME="Command Center"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL=https://CHANGE-ME

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE-ME
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

# File sessions and cache work before the database is set up (first login).
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="you@example.com"

# One-time key for creating the first admin account at /login.
ADMIN_PASSWORD={{ADMIN_PASSWORD}}

# Background work: after page visits, and from the pinger URL on the System page.
BACKGROUND_RUNNER=true

# AI drafting (Claude). Optional here: it can also be set on the System page.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Africa's Talking bulk SMS (broadcasts). Username "sandbox" for testing.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
