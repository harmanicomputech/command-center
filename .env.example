APP_NAME="Command Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://command.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=command_center
DB_USERNAME=
DB_PASSWORD=

# File sessions and cache work before the database exists (first set-up).
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="you@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Command Center -----------------------------------------------------------

# One-time key for creating the first admin account at /login.
ADMIN_PASSWORD=

# Background work runs after page visits and from the pinger URL on the
# System page (the host has no per-minute cron).
BACKGROUND_RUNNER=true

# AI drafting (Claude). Optional here: it can also be set on the System page.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Africa's Talking bulk SMS (broadcasts). Username "sandbox" for testing.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
